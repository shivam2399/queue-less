{
  "name": "queueless",
  "version": "1.0.0",
  "description": "Smart appointment and walk-in queue management platform for local service businesses",
  "private": true,
  "scripts": {
    "server:install": "cd server && npm install",
    "client:install": "cd client && npm install",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "server:test": "cd server && npm test",
    "test": "cd server && npm test",
    "seed": "cd server && npm run db:seed"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
