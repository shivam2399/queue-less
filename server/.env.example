NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=queueless
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# CSRF Protection
CSRF_SECRET=replace_this_with_a_secure_csrf_secret_min_32_chars
